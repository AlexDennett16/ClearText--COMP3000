<UserControl
    x:Class="ClearText.Dialogs.DataDisplayDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ClearText.Dialogs"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DataDisplayDialogViewModel"
    mc:Ignorable="d">

    <Border
        MaxWidth="750"
        MaxHeight="400"
        Padding="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#4D4D4D"
        BoxShadow="0 6 18 0 #40000000"
        CornerRadius="16">

        <Grid RowDefinitions="Auto,*,Auto">

            <!--  Header  -->
            <StackPanel Grid.Row="0" Spacing="16">
                <TextBlock
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#FFF"
                    Text="{Binding Title}" />

                <Border
                    Height="1"
                    Margin="0,0,0,8"
                    Background="#000" />
            </StackPanel>

            <!--  Stats content  -->
            <StackPanel Grid.Row="1" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#FFF"
                        Text="Word Count:" />
                    <TextBlock
                        FontSize="16"
                        Foreground="#FFF"
                        Text="{Binding Stats.WordCount}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#FFF"
                        Text="Character Count:" />
                    <TextBlock
                        FontSize="16"
                        Foreground="#FFF"
                        Text="{Binding Stats.CharacterCount}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#FFF"
                        Text="Flesch-Kincaid Grade Level:" />
                    <TextBlock
                        FontSize="16"
                        Foreground="#FFF"
                        Text="{Binding Stats.FleschKincaidGradeLevel}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#FFF"
                        Text="Flesch-Kincaid Breakdown:" />
                    <TextBlock
                        FontSize="16"
                        Foreground="#FFF"
                        Text="{Binding Stats.FleschKincaidBreakdown}" />
                </StackPanel>
            </StackPanel>

            <!--  Bottom-left button  -->
            <Button
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Command="{Binding CloseCommand}"
                Content="Close" />
        </Grid>
    </Border>
</UserControl>
