<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Button.EditorButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#6E6E6E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.EditorButton:pointerover">
        <Setter Property="Background" Value="#22FFFFFF" />
    </Style>

    <Style Selector="Button.EditorButton.Primary">
        <Setter Property="Background" Value="#2F6FED" />
        <Setter Property="BorderBrush" Value="#2F6FED" />
    </Style>
</Styles>
