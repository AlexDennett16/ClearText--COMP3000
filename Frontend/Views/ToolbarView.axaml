<UserControl
    x:Class="ClearText.Views.ToolbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ClearText.ViewModels.Toolbar"
    x:DataType="vm:ToolbarViewModel">

    <Grid Background="{DynamicResource DefaultTabBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image
            Grid.Column="0"
            VerticalAlignment="Center"
            Source="../Resources/ClearTextLogo.png" />

        <ContentControl
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Content="{Binding CurrentToolbar}">
            <ContentControl.DataTemplates>

                <DataTemplate DataType="vm:DashboardToolbarViewModel">
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="6*,*">
                        <Grid Grid.Column="0" Margin="20,0">
                            <TextBox
                                Height="45"
                                MinWidth="200"
                                MaxWidth="600"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="{Binding Parent.SearchText}"
                                Watermark="Search documents..." />
                        </Grid>
                        <Grid Grid.Column="1" Margin="20,0">
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding Parent.SettingsCommand}"
                                Content="Settings" />
                        </Grid>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:EditorToolbarViewModel">
                    <StackPanel Orientation="Horizontal" />
                </DataTemplate>

            </ContentControl.DataTemplates>
        </ContentControl>
    </Grid>
</UserControl>
