<UserControl
    x:Class="ClearText.Views.Toolbar.EditorToolbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ClearText.ViewModels.Toolbar"
    x:DataType="vm:EditorToolbarViewModel">

    <Grid Background="{DynamicResource DefaultTabBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image
            Grid.Column="0"
            VerticalAlignment="Center"
            Source="../../Resources/ClearTextLogo.png" />



        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="32"
                FontWeight="SemiBold"
                Foreground="White"
                LetterSpacing="0.8"
                Text="{Binding FileName}" />
        </StackPanel>


    </Grid>
</UserControl>
